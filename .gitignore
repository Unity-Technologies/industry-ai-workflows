.venv/
.idea/
.vscode/
__pycache__/
*.py[cod]
*.pyo

# Credentials and local secrets. `.env` alone would not cover a mistyped
# variant like `.env.prod`, and nothing in this repo should ever carry a key.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
token.json

# Local sample CAD files — supply your own; not distributed with the repo.
Sample_CAD/

# Pixyz SDK runtime state (license config etc.) — machine-specific, never commit.
Asset_Transformer_MCP/PixyzSDK/

# Generated per-machine by install.py; do not commit (paths are OS-specific).
.mcp.json

# Generated by install.py; per-run output, not source.
install.log

# Local Claude Code state — not part of the plugin distribution.
.claude/*
!.claude/commands/

# Per-developer notes / scratch — not part of the plugin distribution.
CLAUDE.md

# Build outputs
build_installer/
dist/
