# Asset_Transformer_MCP license server settings (FlexLM floating licenses only)
# Copy this file to .env and set values for your environment.

AT_LICENSE_SERVER_HOST=your-license-server-host
AT_LICENSE_SERVER_PORT=27005

# Optional extra Pixyz feature tokens (comma-separated). Leave unset to acquire
# only the mandatory product token, which is all the built-in tools need.
#AT_LICENSE_TOKENS=

# Set to 1 to validate license availability at startup (acquire + immediate
# release) and exit if no license is available. Default: lazy — a seat is only
# taken when the first AT tool runs.
#AT_LICENSE_FAIL_FAST=1

# Max heavy AT operations running at once (default 1; 0 = unlimited).
#AT_MAX_CONCURRENT_JOBS=1
