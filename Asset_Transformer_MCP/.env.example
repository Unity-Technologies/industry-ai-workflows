# Asset_Transformer_MCP license server settings (FlexLM floating licenses only)
# Copy this file to .env and set values for your environment.
#
# When installed as a Claude Code plugin, the common settings are prompted for
# by /plugin configure and no .env is needed. The ones marked ENV-ONLY below
# are read from the environment but deliberately not prompted for: they are
# expert or shared-host options, not something to ask every user about.

AT_LICENSE_SERVER_HOST=your-license-server-host
AT_LICENSE_SERVER_PORT=27005

# ENV-ONLY. Optional extra Pixyz feature tokens (comma-separated). Leave unset
# to acquire only the mandatory product token, which is all the built-in tools
# need — so this matters only if your licence carries extra feature tokens.
#AT_LICENSE_TOKENS=

# ENV-ONLY. Set to 1 to validate license availability at startup (acquire +
# immediate release) and exit if none is available. Default: lazy — a seat is
# only taken when the first AT tool runs. Mainly a diagnostic.
#AT_LICENSE_FAIL_FAST=1

# Max heavy AT operations running at once (default 1; 0 = unlimited).
#AT_MAX_CONCURRENT_JOBS=1

# ENV-ONLY. Refuse a CAD import larger than this many bytes. Unset or 0 means
# no limit, because real CAD assemblies are legitimately many gigabytes. Worth
# setting on a shared host or CI, where one oversized import affects other
# people. See SECURITY.md.
#AT_MAX_IMPORT_BYTES=0
