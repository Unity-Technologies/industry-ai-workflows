# Unity Asset Manager – MCP Server configuration
# Copy this file to .env if you need to override defaults.
# Never commit .env to source control.

# Auth is browser-based Unity user login (PKCE). No credentials are stored in
# env; run the unity_login MCP tool to sign in via browser. Tokens are cached
# under ~/.uap_mcp/token.json (or $UAP_MCP_HOME) — the cache is shared with
# the Pipeline Automation MCP server, so one login authenticates both.

# Org/project scope is chosen per session with the set_default_organization /
# set_default_project tools (or per-call org_id / project_id arguments) —
# no presets required here.

# Private cloud (VPC) — leave blank for standard public Unity Cloud.
# UNITY_VPC_FQDN=<your-private-cloud.example.com>
# UNITY_VPC_PATH_PREFIX=backend
# UNITY_VPC_OPENID_CONFIG_URL=   # default: https://<host>/auth/realms/unity/.well-known/openid-configuration
# UNITY_VPC_CLIENT_ID=           # default: dashboard
# UNITY_VPC_ASSETS_PATH=         # default: assets/v1
